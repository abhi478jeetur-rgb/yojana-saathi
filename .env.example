# ---------------------------------------------------------------
# Demo mode needs NOTHING. Leave this file alone and run `npm run dev`.
# Copy to .env to enable Appwrite mode.
# ---------------------------------------------------------------

# --- Browser (Vite). Public values, safe to expose. ---
VITE_APPWRITE_ENDPOINT=https://<REGION>.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=<YOUR_PROJECT_ID>
# Optional overrides (defaults shown)
VITE_APPWRITE_DATABASE_ID=yojana
VITE_APPWRITE_SCHEMES_TABLE=schemes
VITE_APPWRITE_CHECKLISTS_TABLE=checklists
VITE_APPWRITE_MATCH_FUNCTION_ID=match-schemes

# --- Seed script only (scripts/seed.mjs). NEVER expose to the browser. ---
APPWRITE_ENDPOINT=https://<REGION>.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=<YOUR_PROJECT_ID>
# API key scopes required for seeding:
#   databases.read databases.write tables.read tables.write columns.read columns.write
#   indexes.read indexes.write rows.read rows.write
#   vectorsdb.read vectorsdb.write collections.read collections.write documents.read documents.write
#   embeddings.write
APPWRITE_API_KEY=<SERVER_API_KEY>
# Optional: VectorsDB compute specification slug (see `listSpecifications`). Dedicated tiers may cost money.
APPWRITE_VECTORSDB_SPEC=
VECTORS_DB_ID=yojana_vectors
VECTORS_COLLECTION_ID=scheme_embeddings

# --- Function match-schemes (set in the Appwrite Console > Function > Settings) ---
# Function scopes: embeddings.write vectorsdb.read collections.read documents.read
# Function variables: VECTORS_DB_ID, VECTORS_COLLECTION_ID (same values as above)
# Execute permission: any (or users)
